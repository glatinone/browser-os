          "nodeType": 3,
          "nodeName": "#text",
          "localName": "",
          "nodeValue": "\nconst cover = document.getElementById('cover');\nconst paid = document.getElementById('paid');\nconst revealOnMove = new URLSearchParams(location.search).get('variant') === 'reveal';\ndocument.getElementById('covered-button').addEventListener('click', () => { paid.hidden = false; });\nfunction removeCover() { cover.style.display = 'none'; }\ncover.addEventListener('click', removeCover);\ndocument.addEventListener('click', () => setTimeout(removeCover, 0));\nif (revealOnMove) {\n  // The CDP click refuses this in a few hundred milliseconds, and the Playwright fallback then\n  // waits for the element to receive events: this is the window in which the second one wins.\n  setTimeout(removeCover, 1200);\n} else {\n  setTimeout(removeCover, 800);\n}\n",
          "attributes": [],
          "textValue": "\nconst cover = document.getElementById('cover');\nconst paid = document.getElementById('paid');\nconst revealOnMove = new URLSearchParams(location.search).get('variant') === 'reveal';\ndocument.getElementById('covered-button').addEventListener('click', () => { paid.hidden = false; });\nfunction removeCover() { cover.style.display = 'none'; }\ncover.addEventListener('click', removeCover);\ndocument.addEventListener('click', () => setTimeout(removeCover, 0));\nif (revealOnMove) {\n  // The CDP click refuses this in a few hundred milliseconds, and the Playwright fallback then\n  // waits for the element to receive events: this is the window in which the second one wins.\n  setTimeout(removeCover, 1200);\n} else {\n  setTimeout(removeCover, 800);\n}\n",
