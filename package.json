{
  "name": "browser-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bench": "echo \"see benchmarks/\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
