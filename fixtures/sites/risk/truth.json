{
  "intents": [
    {
      "action": "click",
      "intent": "Delete account",
      "expect": {
        "css": "button[onclick*='confirm']",
        "role": "button",
        "name": "Delete account"
      }
    },
    {
      "action": "click",
      "intent": "Yes, delete",
      "expect": {
        "css": "#confirm button:first-of-type",
        "role": "button",
        "name": "Yes, delete"
      }
    },
    {
      "action": "click",
      "intent": "Keep my account",
      "expect": {
        "css": "#confirm button:last-of-type",
        "role": "button",
        "name": "Keep my account"
      }
